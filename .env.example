# Universal portable configuration (all paths relative to project root)
LOCAL_NOTEBOOK_DATA_DIR=./local-notebook-data
UPLOAD_DIR=./local-notebook-data/uploads
DATABASE_URL=sqlite+aiosqlite:///./local-notebook-data/local_notebook.db
MILVUS_URI=./local-notebook-data/milvus.db
REDIS_URL=memory://

# Backend & Frontend ports
BACKEND_PORT=8081
FRONTEND_PORT=8080
EMBEDDING_PORT=8001

# Auth
SECRET_KEY=local-notebook-universal-secret-key-change-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Large-document summary sampling (quality/performance trade-off)
SEGMENT_SUMMARY_FULL_LIMIT=200
SEGMENT_SUMMARY_SAMPLE_MIN=32
SEGMENT_SUMMARY_SAMPLE_MAX=64
SEGMENT_SUMMARY_SAMPLE_RATIO=0.15
SEGMENT_SUMMARY_CONCURRENCY=2
SEGMENT_SUMMARY_MAX_ATTEMPTS=5


# ── Web search (SearXNG in Docker, see services/searxng) ─────────────────────
# ./start.sh starts SearXNG when Docker/OrbStack is available; set 0 to manage it yourself.
# LOCAL_NOTEBOOK_SEARXNG=1
# SEARXNG_PORT=8888
# SEARXNG_SECRET=   # created automatically by ./start.sh
